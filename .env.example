OPENCLOUD_IMAGE=opencloudeu/opencloud
OPENCLOUD_IMAGE_TAG=7.2.5
ENTRA_TENANT_ID=REPLACE_WITH_TENANT_ID
ENTRA_CLIENT_ID=REPLACE_WITH_CLIENT_ID
ENTRA_ADMIN_GROUP_ID=REPLACE_WITH_ADMIN_GROUP_OBJECT_ID
ENTRA_STAFF_GROUP_ID=REPLACE_WITH_STAFF_GROUP_OBJECT_ID
OPENCLOUD_DOMAIN=REPLACE_WITH_DOMAIN
OPENCLOUD_MEM_LIMIT=2.5G
OPENCLOUD_PROXY_CONFIG_FILE=./.local/proxy.yaml
# OPENCLOUD_YAML_SECRET_NAME is supplied by the reconciliation mapping.
# OPENCLOUD_PROXY_CONFIG_NAME and OPENCLOUD_ENTRA_CSP_CONFIG_NAME are supplied
# by scripts/render-proxy-config.py.
