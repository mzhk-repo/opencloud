OPENCLOUD_DOMAIN=REPLACE_WITH_DOMAIN
OPENCLOUD_IMAGE_TAG=9.1.1
ENTRA_TENANT_ID=REPLACE_WITH_TENANT_ID
ENTRA_CLIENT_ID=REPLACE_WITH_CLIENT_ID
ENTRA_ADMIN_GROUP_ID=REPLACE_WITH_ADMIN_GROUP_OBJECT_ID
ENTRA_STAFF_GROUP_ID=REPLACE_WITH_STAFF_GROUP_OBJECT_ID
OPENCLOUD_MEM_LIMIT=2.5G
OPENCLOUD_PROXY_NETWORK=proxy-net
OPENCLOUD_DATA_PATH=/srv/opencloud/data
OPENCLOUD_UID=1000
OPENCLOUD_GID=1000
BORG_PASSPHRASE=REPLACE_WITH_BORG_PASSPHRASE
OPENCLOUD_YAML_B64=REPLACE_WITH_BASE64_ENCODED_OPENCLOUD_YAML
# Backup settings: keep the local repository outside the data tree and the mount.
BACKUP_LOCAL_DIR=/srv/opencloud/backup
BACKUP_RCLONE_REMOTE=REPLACE_WITH_RCLONE_REMOTE_NAME
BACKUP_RCLONE_FOLDER=opencloud
BACKUP_RCLONE_MOUNT=/srv/rclone
NODE_EXPORTER_TEXTFILE_DIR=/data/node-exporter-textfile
